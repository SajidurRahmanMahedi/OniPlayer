# ==========================================
# OniPlayer Git Attributes Configuration
# Ensure line endings are standard and binaries aren't corrupted
# ==========================================

# Set default behavior to automatic line ending normalization.
* text=auto

# Explicitly declare text files to be normalized to LF on commit.
*.py text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.iss text eol=lf
*.sh text eol=lf

# Explicitly declare files that are always binary and must not be modified.
*.dll binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.aar binary
*.tar.gz binary
*.tgz binary
*.tar binary

# Make sure Windows batch files keep CRLF endings for Windows execution
*.bat text eol=crlf
*.cmd text eol=crlf
